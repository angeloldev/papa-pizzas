# PIX — use sua chave real (CPF, e-mail, telefone ou chave aleatória)
PIX_CHAVE=seu-email@exemplo.com
PIX_NOME_BENEFICIARIO=SEU NOME AQUI
PIX_CIDADE=BRASILIA

# JWT — gere uma chave forte:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=substitua-por-uma-chave-segura-de-64-chars-hex

# --- Somente em produção (Render) ---
# Connection string do Postgres gerenciado (Neon/Supabase). Sem esta variável,
# a API usa SQLite local automaticamente.
# DATABASE_URL=postgresql://usuario:senha@host/banco

# Origens (frontend) autorizadas a chamar a API, separadas por vírgula.
# ALLOWED_ORIGINS=https://www.papapizzas.com.br,https://papapizzas.com.br
